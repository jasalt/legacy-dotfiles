[global_config]
  tab_position = bottom
  inactive_color_offset = 1.0
  enabled_plugins = ,
  suppress_multiple_term_dialog = True
[keybindings]
  cycle_next = <Primary>Tab
  cycle_prev = <Primary><Shift>Tab
  go_next = ""
  go_prev = ""
  go_up = None
  go_down = None
  go_left = None
  go_right = None
  split_horiz = <Primary><Shift>o
  split_vert = <Primary><Alt>o
  close_term = <Primary><Shift>w
  toggle_scrollbar = None
  close_window = ""
  toggle_zoom = None
  next_tab = None
  switch_to_tab_1 = <Alt>1
  switch_to_tab_2 = <Alt>2
  switch_to_tab_3 = <Alt>3
  switch_to_tab_4 = <Alt>4
  switch_to_tab_5 = <Alt>5
  switch_to_tab_6 = <Alt>6
  switch_to_tab_7 = <Alt>7
  switch_to_tab_8 = <Alt>8
  switch_to_tab_9 = <Alt>9
  hide_window = None
  ungroup_all = None
  ungroup_tab = None
  new_window = <Primary><Shift>n
  insert_number = None
  insert_padded = None
  edit_window_title = ""
  edit_tab_title = ""
  edit_terminal_title = ""
  help = ""
[profiles]
  [[default]]
    background_color = "#282828"
    background_darkness = 1.0
    background_type = transparent
    color_scheme = custom
    cursor_blink = False
    font = Inconsolata Nerd Font Mono Bold 13
    foreground_color = "#ebdbb2"
    show_titlebar = False
    scrollbar_position = hidden
    scrollback_lines = 5000
    scrollback_infinite = True
    palette = "#282828:#cc241d:#98971a:#d79921:#458588:#b16286:#689d6a:#a89984:#928374:#fb4934:#b8bb26:#fabd2f:#83a598:#d3869b:#8ec07c:#ebdbb2"
    use_system_font = False
[layouts]
  [[default]]
    [[[child1]]]
      parent = window0
      profile = default
      type = Terminal
    [[[window0]]]
      parent = ""
      type = Window
[plugins]
