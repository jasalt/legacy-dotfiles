				<string>on alfred_script(q)

tell application "Mail"	-- set selected mailboxes of message viewer 1 to {inbox}	activate
	make new message viewer at front
    -- if (count of message viewers) is 0 then				-- set selected mailboxes of message viewer 1 to {inbox}    --	end if
	tell application "System Events"		delay 0.2		keystroke "f" using {command down, option down}		keystroke "a" using {command down}		-- delay 0.5		key code 51				keystroke q as string	end tellend tell

end alfred_script</string>
