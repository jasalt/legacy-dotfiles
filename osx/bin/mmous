# magic mouse reconnect/connect script to easily switch it between devices by unpairing it if it's connected and pairing if it's not connected

# prereq:
# brew install blueutil
# blueutil --paired # check the address first and replace in this script

res=$(<blueutil_folder>/blueutil --is-connected 3c-a6-f6-c2-8f-e0)
if [[ "$res" = '1' ]]
then
<blueutil_folder>/blueutil --unpair 3c-a6-f6-c2-8f-e0
else
<blueutil_folder>/blueutil --unpair 3c-a6-f6-c2-8f-e0
sleep 1
<blueutil_folder>/blueutil --pair 3c-a6-f6-c2-8f-e0
sleep 1
<blueutil_folder>/blueutil --connect 3c-a6-f6-c2-8f-e0
fi
